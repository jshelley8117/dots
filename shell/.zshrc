# --- ALIASES ---
# -- Go Aliases --
alias gomt="go mod tidy"
alias gotc="go test ./... -cover"
alias goft="go fmt ./..."
alias gogu="go get -u ./..."
# -- Git Aliases --
alias gitpl="git pull"
alias gitft="git fetch origin"
alias gitlo = "git log --oneline --graph --decorate --all"
alias gitsw="git switch"
alias gitch="git checkout -b"
alias gitadm="git commit -am"
# -- Other Aliases --
alias c="clear"
alias h="history"
# -- ZShell Aliases --
alias zshrc="nvim ~/.zshrc"
alias zshsource="source ~/.zshrc"

